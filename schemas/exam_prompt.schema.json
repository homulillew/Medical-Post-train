{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamPrompt reward-side source record",
  "type": "object",
  "required": ["prompt_id", "source", "source_revision", "source_row", "question", "options", "answer_set", "reference_explanation", "split", "cluster_id", "explanation_missing"],
  "properties": {
    "prompt_id": {"type": "string", "minLength": 1},
    "source": {"const": "CMExam"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_row": {"type": "integer", "minimum": 0},
    "question": {"type": "string", "minLength": 1},
    "options": {"type": "object", "minProperties": 2, "maxProperties": 5, "propertyNames": {"pattern": "^[A-E]$"}, "additionalProperties": {"type": "string", "minLength": 1}},
    "answer_set": {"type": "string", "pattern": "^[A-E]+$"},
    "reference_explanation": {"type": "string"},
    "explanation_missing": {"type": "boolean"},
    "split": {"enum": ["train", "val"]},
    "cluster_id": {"type": "string", "minLength": 1}
  },
  "description": "Actor messages are constructed solely from question, options and fixed format instruction. Answers, explanation and cluster metadata remain reward-side only. Canonical set/option membership enforced by Python validator."
}
