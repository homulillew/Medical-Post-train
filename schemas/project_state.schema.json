                "FAILED",
                "BLOCKED"
              ]
            },
            "run_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "progress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "consistency_prompts",
                "real_requests_total",
                "concurrency_conditions"
              ],
              "properties": {
                "consistency_prompts": {
                  "type": "integer",
                  "minimum": 0
                },
                "real_requests_total": {
                  "type": "integer",
                  "minimum": 0
                },
                "concurrency_conditions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      1,
                      4,
                      8,
                      16
                    ]
                  },
                  "uniqueItems": true
                }
              }
            },
            "verification_receipt": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "verifier_commit",
                    "contract_sha256",
                    "result"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "verifier_commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "contract_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "result": {
                      "const": "PASS"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "stage_report": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "interview_story": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "FULL_PASS",
                      "VERIFIED",
                      "DONE"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "run_ids": {
                    "minItems": 1
                  },
                  "progress": {
                    "properties": {
                      "consistency_prompts": {
                        "minimum": 100
                      },
                      "real_requests_total": {
                        "minimum": 100
                      },
                      "concurrency_conditions": {
                        "minItems": 4
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "VERIFIED",
                      "DONE"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "verification_receipt": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256",
                      "verifier_commit",
                      "contract_sha256",
                      "result"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "verifier_commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      },
                      "contract_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "result": {
                        "const": "PASS"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "DONE"
                  }
                }
              },
              "then": {
                "properties": {
                  "stage_report": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interview_story": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
